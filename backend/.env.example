# AI Verify Backend - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_URL=jdbc:postgresql://localhost:5432/ai_verify
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here

# ===========================================
# MISTRAL AI API
# ===========================================
MISTRAL_API_KEY=your_mistral_api_key_here

# ===========================================
# SECURITY SETTINGS
# ===========================================
# JWT Secret - must be at least 32 characters for HS256
JWT_SECRET=your_very_long_and_secure_jwt_secret_at_least_32_chars

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# ===========================================
# ADMIN INITIALIZATION (Development only)
# ===========================================
# These are only used in 'dev' profile
# Password must be at least 12 characters
APP_INIT_ADMIN_USERNAME=admin
APP_INIT_ADMIN_PASSWORD=SecureAdminPass123!
APP_INIT_ADMIN_EMAIL=admin@yourdomain.com

# ===========================================
# SONARQUBE (Optional - CI/CD)
# ===========================================
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonar_token_here

# ===========================================
# RATE LIMITING
# ===========================================
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
SECURITY_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_API_MAX_REQUESTS=100
SECURITY_RATE_LIMIT_API_WINDOW_SECONDS=60
