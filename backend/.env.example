# Backend environment variables
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Session cookie settings
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Database configuration
DB_URL=jdbc:postgresql://localhost:5432/ai_verify
DB_USER=postgres
DB_PASSWORD=postgres

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_ISSUER_URI=https://fond-teal-84.clerk.accounts.dev

# OpenRouter API (Used for Detection and Advisor)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_DETECTION_MODEL=google/gemini-2.5-flash
OPENROUTER_ADVISOR_MODEL=google/gemini-2.5-flash

# Google Gemini Detection Engine (optional fallback)
GEMINI_API_KEY=


# Mistral AI configuration
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_DETECTION_MODEL=mistral-large-latest

# NVIDIA API configuration
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_DETECTION_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_ADVISOR_MODEL=meta/llama-3.1-70b-instruct

# Optional local monitoring values
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonar_token_here

# Rate limiting
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_TRUST_PROXY=false
SECURITY_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
SECURITY_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_API_MAX_REQUESTS=100
SECURITY_RATE_LIMIT_API_WINDOW_SECONDS=60

# Commercial SaaS Billing (Stripe)
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PORTAL_CONFIGURATION_ID=
APP_PUBLIC_URL=http://localhost:3000
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7